{
  "title": "Culdcept Saga",
  "package": "culdcept-nx",
  "nro": "culdcept-nx.nro",
  "shaders": false,
  "lz4": [
    "(?!default\\.xex$|data/MOVIE/|data/SOUND/).*"
  ],
  "zxc": [
    "data/DATA04\\.RSP",
    ".*\\.RS[AELMT]"
  ],
  "movies": {
    "match": "data/MOVIE/.*\\.wmv",
    "fraction": 0.35,
    "gop": 120
  },
  "audio": {
    "match": "data/SOUND/.*\\.xma",
    "bitrates": [
      {
        "match": "data/SOUND/bgm_.*",
        "stereo": 128000,
        "mono": 64000
      },
      {
        "match": "data/SOUND/se.*",
        "stereo": 96000,
        "mono": 48000
      },
      {
        "match": ".*",
        "stereo": 64000,
        "mono": 32000
      }
    ]
  },
  "skip": [
    "\\$SystemUpdate/.*"
  ],
  "needs": [
    "data/DATA0[0-6]\\.RSP",
    "data/shader\\.fx",
    "eeprev/.*",
    "layout/.*"
  ],
  "dlc": false,
  "texts": {
    "game": "Your Xbox 360 disc of Culdcept Saga as an <code>.iso</code>, or the folder it was extracted to (with <code>default.xex</code>, <code>data/</code>, <code>eeprev/</code> and <code>layout/</code>).",
    "settings": "The game writes its settings file, <code>culdcept.toml</code>, at its first start.",
    "footer": "Culdcept Saga is a trademark of OmiyaSoft and Bandai Namco Entertainment. Not affiliated with or endorsed by OmiyaSoft, Bandai Namco, Microsoft or Nintendo."
  }
}
